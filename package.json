{
  "name": "sat-event-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/refresh-data.ts && vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "refresh-data": "node scripts/refresh-data.ts",
    "refresh-data:strict": "node scripts/refresh-data.ts --strict",
    "validate-data": "node scripts/validate-data.ts",
    "build:satellites": "tsc --noEmit && vite build --base=/satellites/"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "luxon": "^3.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satellite.js": "^7.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "description": "Plan family radio-club events around multiple FM amateur-radio satellite passes."
}
